# Copy to .env (gitignored) and fill in to enable the ✉ Email button.
# Gmail App Password — needs 2-Step Verification on the account.
# Create one at https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop   # spaces are fine; stripped on load

# Optional: override for a non-Gmail SMTP server.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
